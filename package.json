{
  "name": "dsh-ruleset",
  "version": "0.2.0",
  "type": "module",
  "description": "Behavioral rule compliance for DeepSeek Harness: one policy file drives both prompt injection and three-value evidence checks. Audits agent behavior, not plugin quality.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "docs-schema.md",
    "examples",
    "lib",
    "locale",
    "schema",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-behavior",
    "compliance",
    "policy",
    "audit"
  ],
  "author": "caifengmao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cengcengcai-creator/dsh-ruleset.git"
  },
  "homepage": "https://github.com/cengcengcai-creator/dsh-ruleset#readme",
  "bugs": {
    "url": "https://github.com/cengcengcai-creator/dsh-ruleset/issues"
  }
}